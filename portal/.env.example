# Copy to portal/.env and fill in. Never commit the real file.

# --- TTLock Open Platform (open.ttlock.com -> your application) -------------
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=

# The TTLock *app* account that owns the locks.
TTLOCK_USERNAME=
# Either the plaintext account password or its lowercase MD5 hash --
# the server hashes plaintext for you, so storing the hash is safer.
TTLOCK_PASSWORD=

# api.ttlock.com (default) or euapi.ttlock.com for EU accounts.
# TTLOCK_BASE_URL=https://api.ttlock.com

# --- Sessions --------------------------------------------------------------
# Required. Signs session tokens; without it every restart signs staff out.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

SESSION_HOURS=12
PORT=8080

# --- First admin (used only when there are no staff accounts yet) -----------
PORTAL_ADMIN_NAME=Darren
PORTAL_ADMIN_EMAIL=frontdesk@walkertonlivery.ca
# Leave blank to have one generated and printed at first boot; you will be
# asked to change it at first sign-in either way.
PORTAL_ADMIN_PASSWORD=

# --- House details ---------------------------------------------------------
# Whole hours only — TTLock ignores minutes in a passcode window.
CHECKIN_HOUR=15
CHECKOUT_HOUR=11

# Wording used in the message staff send guests.
PROPERTY_NAME=the Walkerton Livery
PROPERTY_ADDRESS=11 Victoria St S, Walkerton
PARKING_NOTE=Park in the lot behind the building or on the street — both are free.

# Where staff accounts and the activity log are kept.
# DATA_FILE=./data/portal.json
